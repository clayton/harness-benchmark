.cursor/

# Local run artifacts (keep directory via .gitkeep; ignore contents)
results/*/
!results/.gitkeep
reports/*
!reports/.gitkeep

# Cloned scenario workspaces (large; re-fetch via scripts / hb prepare)
workspaces/

# Vendored experiment deps (large clones; see vendor/README.md)
vendor/superpowers/
vendor/*/
!vendor/README.md

# Occasional local dumps
*.log
tmp/
.cache/

# Go CLI build output
/bin/
/hb-out/
